# Sensus AI backend
APP_NAME="Sensus AI"
HOST=0.0.0.0
PORT=8000
RELOAD=false
ALLOWED_ORIGINS=*

# IA visual
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=7
GEMINI_MAX_OUTPUT_TOKENS=220

# Vision rapida opcional (se instala en un worker local, no en el EC2 pequeno)
YOLO_ENABLED=false
YOLO_MODEL_PATH=backend/models/yolo26n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IMAGE_SIZE=320
YOLO_MAX_DETECTIONS=12
SAFETY_REPEAT_SECONDS=3

# Seguridad de carga
MAX_UPLOAD_BYTES=4194304
