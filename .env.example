# Sensus AI backend
APP_NAME="Sensus AI"
HOST=0.0.0.0
PORT=8000
RELOAD=false
ALLOWED_ORIGINS=*

# IA visual
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=7
GEMINI_MAX_OUTPUT_TOKENS=220

# Vision rapida opcional (se instala en un worker local, no en el EC2 pequeno)
YOLO_ENABLED=true
YOLO_MODEL_PATH=backend/models/yolo26n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IMAGE_SIZE=640
YOLO_MAX_DETECTIONS=30
DEPTH_ENABLED=true
DEPTH_MODEL_NAME=depth-anything/Depth-Anything-V2-Metric-Indoor-Small-hf
DEPTH_IMAGE_SIZE=448
DEPTH_MAX_OBJECTS=20
DEPTH_CALIBRATION_FILE=backend/ProyectoProfundidad/calibracion.json
DEPTH_CALIBRATION_A=1.0
DEPTH_CALIBRATION_B=0.0
DEPTH_DANGER_M=1.0
DEPTH_ATTENTION_M=2.5
DEPTH_CORRIDOR_M=1.6
SAFETY_REPEAT_SECONDS=3

# Seguridad de carga
MAX_UPLOAD_BYTES=4194304
